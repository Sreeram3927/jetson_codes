<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delta_nodes</name>
  <version>0.0.0</version>
  <description>Jetson-side ROS2 nodes: ESP32/Arduino serial bridges, camera target ingest, frame transform, target selection, command arbitration, frontend websocket bridge</description>
  <maintainer email="sreeram3927@zohomail.in">Sreeram</maintainer>
  <license>TODO: License declaration</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>delta_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
